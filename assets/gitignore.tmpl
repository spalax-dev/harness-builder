# STACK: generic .gitignore template.
# Copy to .gitignore and add project-local paths.
#
# Tracked: BACKLOG.md, .harness/state.json, docs/planning/**, progress/history.md.
# Local: activities.json, the computed schedule, claims, approvals,
# progress/current.md, generated docs and secrets.

# Dependencies
node_modules/
.pnpm-store/
.yarn/
vendor/

# Build output
dist/
build/
out/
target/
bin/
obj/

# Framework and test caches
.next/
.nuxt/
.svelte-kit/
.output/
.angular/
.turbo/
.nx/
.cache/
.parcel-cache/
.vite/
coverage/
.nyc_output/

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.mypy_cache/
.pytest_cache/
.ruff_cache/
.tox/

# Go / Rust
*.test
*.out

# Generated documentation (build output; never hand-edited)
docs/api/
docs/site/
site/
_build/
.docusaurus/

# Logs and local noise
*.log
*.tmp
.DS_Store
Thumbs.db

# Harness session state (local only)
/activities.json
/progress/current.md
/.harness/*
!/.harness/state.json

# Secrets — never commit
.env
.env.*
!.env.example
*.pem
*.key
credentials*.json
service-account*.json


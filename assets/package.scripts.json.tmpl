{
  "_comment": "Merge these scripts into package.json. `harness` is stage-aware. Do not add a CI alias that skips tests; do not add --no-cache until a cache exists.",
  "scripts": {
    "harness": "node scripts/harness.mjs",
    "harness:stage": "node scripts/harness.mjs --stage",
    "harness:planning": "node scripts/harness.mjs --planning",
    "harness:start-dev": "node scripts/harness.mjs --start-dev",
    "harness:schedule": "node scripts/harness.mjs --schedule",
    "harness:fast": "node scripts/harness.mjs --fast",
    "harness:changed": "node scripts/harness.mjs --changed",
    "harness:explain": "node scripts/harness.mjs --explain",
    "build:harness": "node scripts/build_harness.mjs",
    "test:harness": "node --test scripts/harness-lib.spec.mjs"
  }
}
